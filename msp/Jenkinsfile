pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
    }

    environment {
        DOCKER_PROJECT_NAME = 'msp'
        SONARQUBE_INSTANCE = 'SonarQube'
        REGISTRY_URL = 'localhost:5000'
        SERVICES = "config-server gateway MarketChino-master registry-server report-ms"
        DB_NAME = "chinomarket"
        DB_USER = "chinomarketserver"
        DB_PASSWORD = "chinomarket2025"
        REPO_URL = "https://github.com/Fabri-art/proyecto_Dockerizado.git"
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def services = env.SERVICES.split()
                    withSonarQubeEnv(env.SONARQUBE_INSTANCE) {
                        for (svc in services) {
                            dir("msp/${svc}") {
                                echo "📊 Analizando ${svc}..."
                                sh 'mvn clean verify sonar:sonar -DskipTests'
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    echo "✅ Esperando resultados del análisis..."
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build and Dockerize') {
            steps {
                script {
                    def services = env.SERVICES.split()
                    def registry = env.REGISTRY_URL

                    for (svc in services) {
                        def path = "msp/${svc}"
                        def imageName = "${registry}/${svc}:latest"

                        echo "⚙️ Construyendo y dockerizando ${svc}..."

                        dir(path) {
                            sh 'mvn clean package -DskipTests'
                        }

                        sh "docker build -t ${imageName} ${path}"
                        sh "docker push ${imageName}"
                    }
                }
            }
        }

        stage('Clean Database Volume') {
            steps {
                script {
                    echo '🧹 Eliminando volumen PostgreSQL para reinicialización...'
                    try {
                        sh 'docker volume rm msp_postgres_data || true'
                        echo '✅ Volumen eliminado correctamente'
                    } catch (Exception e) {
                        echo "⚠️ Volumen no existía o no se pudo eliminar, se continuará de todos modos"
                    }
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                dir('.') {
                    script {
                        echo '🚀 Levantando microservicios...'
                        try {
                            sh "docker-compose -p ${env.DOCKER_PROJECT_NAME} down -v --remove-orphans"
                        } catch (Exception e) {
                            echo "⚠️ No hay contenedores antiguos, continuando..."
                        }

                        sh "docker-compose -p ${env.DOCKER_PROJECT_NAME} up -d --build"

                        echo '⏳ Esperando que arranque todo...'
                        sleep(30)

                        echo '📋 Mostrando logs de gateway:'
                        sh "docker logs --tail 100 gateway"
                    }
                }
            }
        }
    }

    post {
        always {
            echo '🏁 === FINAL DEL PIPELINE ==='
        }
        success {
            echo '🎉 ✓ Microservicios desplegados correctamente'
        }
        failure {
            echo '💥 ✗ El pipeline falló, revisar errores'
        }
    }
}
